{
  "name": "yinling-education-ops",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/dev-fixed-port.mjs",
    "build": "npm run build:classroom-tools && next build && node scripts/check-client-bundle-budget.mjs",
    "check:client-bundle": "node scripts/check-client-bundle-budget.mjs",
    "check:architecture": "node scripts/check-api-write-boundaries.mjs",
    "check:fallow": "node scripts/run-fallow-gate.mjs",
    "start": "next start",
    "test": "npm run build && npm run test:unit",
    "test:browser": "playwright test",
    "lint": "eslint . --ignore-pattern .next",
    "test:unit": "node scripts/run-unit-tests.mjs",
    "test:sql-runtime": "node scripts/run-sql-runtime-fixtures.mjs",
    "typecheck:scripts": "tsc --project tsconfig.scripts.json",
    "build:classroom-tools": "npm --prefix plugins/classroom-tools ci --ignore-scripts --no-audit --no-fund && npm --prefix plugins/classroom-tools run typecheck && npm --prefix plugins/classroom-tools test && npm --prefix plugins/classroom-tools run build"
  },
  "dependencies": {
    "@fullcalendar/core": "6.1.21",
    "@fullcalendar/daygrid": "6.1.21",
    "@fullcalendar/interaction": "6.1.21",
    "@fullcalendar/luxon3": "6.1.21",
    "@fullcalendar/timegrid": "6.1.21",
    "fast-xml-parser": "^5.10.1",
    "lucide-react": "^1.25.0",
    "luxon": "3.7.2",
    "next": "16.3.8",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/luxon": "3.7.6",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.8",
    "fallow": "3.26.0",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.1",
    "typescript": "5.9.3"
  },
  "type": "module"
}

# Preferred documented Open API gateway mode. Only this SK is needed for the
# gateway request. It stays server-side and must never be committed or exposed
# to browser code, Actions logs, or workbooks. It needs query_lesson_list for
# the monthly workbook; query_member_simple_list and query_schedule_list are
# optional additional permissions for their read-only browser tools.
JIAOWUBAO_GATEWAY_SK=<assigned-sk>

# Optional HTTPS override. The default is this verified gateway endpoint; do
# not use the HTTP-only URLs printed in the source document for an SK request.
JIAOWUBAO_GATEWAY_URL=https://card.jwbpro.com/open/jwb/gateway

# Gateway mode fixes tool=query_lesson_list, params={...}, ret=1, and limit=100
# (the documented maximum). This caps non-empty data pages; one final empty
# page is always requested to prove the result is complete.
JIAOWUBAO_LESSON_LIST_MAX_PAGES=100

# Leave this unset for interactive website requests so 429 returns promptly.
# The GitHub Actions generator sets it to true and performs at most two bounded
# recovery waits, which is appropriate for a non-interactive job.
JIAOWUBAO_GATEWAY_RETRY_429=

# Direct-tool fallback only: leave this entire block unset when using the
# gateway above. It exists for a separately documented vendor endpoint.
JIAOWUBAO_LESSON_LIST_URL=https://<vendor-endpoint>
JIAOWUBAO_LESSON_LIST_METHOD=POST
JIAOWUBAO_LESSON_LIST_AUTH_HEADER=Authorization
JIAOWUBAO_LESSON_LIST_AUTH_VALUE=<vendor-auth-value>

# Optional gateway wrapper. Keep blank for a flat request body. Fixed gateway
# fields may be added as JSON, but no nested value may contain start/end/sign/
# page/limit/over or documented narrowing filters mem_id/course_id/team_id.
JIAOWUBAO_LESSON_LIST_PARAMS_KEY=
JIAOWUBAO_LESSON_LIST_EXTRA_PARAMS_JSON=
JIAOWUBAO_LESSON_LIST_PAGE_SIZE=200

# Required only for the direct-tool fallback after checking a real successful
# response. Gateway mode hard-codes the documented ret / 1 success assertion.
JIAOWUBAO_LESSON_LIST_SUCCESS_PATH=
JIAOWUBAO_LESSON_LIST_SUCCESS_VALUE=

# Exactly three confirmed JWB试听 B-account mem_id values, comma separated.
# Leave blank to keep every lesson as 待分类 rather than guessing from course
# type or name. A partial mapping is rejected rather than calling it 常规.
JIAOWUBAO_TRIAL_MEMBER_IDS=

# Protects the optional bearer-authenticated export/diagnostic routes. Use a
# distinct random secret of at least 32 characters.
JIAOWUBAO_MONTHLY_PAYROLL_CRON_SECRET=<at-least-32-random-characters>

# Signs the short-lived browser review snapshot used to download the exact
# workbook that was reviewed. Use a distinct, 32+ character random secret.
JIAOWUBAO_MONTHLY_PAYROLL_SNAPSHOT_SECRET=<another-long-random-secret>
